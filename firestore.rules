rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }
    function approvedUid(uid) {
      return exists(/databases/$(database)/documents/allowedUsers/$(uid));
    }

    match /allowedUsers/{uid} {
      allow read: if approved();
      allow write: if false;
    }

    match /users/{uid}/outfits/{outfitId} {
      allow read: if approved();
      allow create, update, delete: if approved() && request.auth.uid == uid;
    }

    match /suggestions/{suggestionId} {
      allow create: if approved()
        && request.resource.data.keys().hasAll(['fromUid','toUid','message','status','createdAt','outfit'])
        && request.resource.data.keys().hasOnly(['fromUid','toUid','message','status','createdAt','outfit'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && approvedUid(request.resource.data.toUid)
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.outfit is map;

      allow read: if approved()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);

      allow update: if approved() && (
        (
          resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted','declined']
        )
        ||
        (
          resource.data.fromUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'withdrawn'
        )
      );

      allow delete: if false;
    }

    match /catalog/{document=**} {
      allow read: if approved();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}