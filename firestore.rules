rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    function approvedUid(uid) {
      return exists(/databases/$(database)/documents/allowedUsers/$(uid));
    }

    function validGarment(part) {
      return part is map
        && part.keys().hasAll(['id', 'description', 'texture'])
        && part.keys().hasOnly(['id', 'description', 'texture'])
        && ((part.id is int && part.id >= 0)
          || (part.id is string && part.id.size() > 0 && part.id.size() <= 120))
        && part.description is string
        && part.description.size() <= 220
        && part.texture is int
        && part.texture >= 0;
    }

    function validOutfitFields(outfit) {
      return outfit.schemaVersion == 1
        && outfit.name is string
        && outfit.name.size() > 0
        && outfit.name.size() <= 60
        && outfit.gender in ['female', 'male']
        && outfit.savedAt is string
        && outfit.savedAt.size() > 0
        && outfit.savedAt.size() <= 80
        && outfit.torsoIndex is int
        && outfit.torsoIndex >= 0
        && outfit.pantsIndex is int
        && outfit.pantsIndex >= 0
        && validGarment(outfit.torso)
        && validGarment(outfit.pants)
        && outfit.archived is bool
        && (('vest' in outfit) == ('vestIndex' in outfit))
        && (!('vest' in outfit)
          || (outfit.vestIndex is int && outfit.vestIndex >= 0 && validGarment(outfit.vest)))
        && (('shoes' in outfit) == ('shoesIndex' in outfit))
        && (!('shoes' in outfit)
          || (outfit.shoesIndex is int && outfit.shoesIndex >= 0 && validGarment(outfit.shoes)))
        && (('tshirt' in outfit) == ('tshirtIndex' in outfit))
        && (!('tshirt' in outfit)
          || (outfit.tshirtIndex is int && outfit.tshirtIndex >= 0 && validGarment(outfit.tshirt)));
    }

    function validOutfit(outfit) {
      return outfit is map
        && outfit.keys().hasAll([
          'schemaVersion',
          'name',
          'gender',
          'savedAt',
          'torsoIndex',
          'pantsIndex',
          'torso',
          'pants',
          'archived'
        ])
        && outfit.keys().hasOnly([
          'schemaVersion',
          'name',
          'gender',
          'savedAt',
          'torsoIndex',
          'pantsIndex',
          'vestIndex',
          'shoesIndex',
          'tshirtIndex',
          'torso',
          'vest',
          'pants',
          'shoes',
          'tshirt',
          'archived'
        ])
        && validOutfitFields(outfit);
    }

    function validStoredOutfit(outfit) {
      return outfit is map
        && outfit.keys().hasAll([
          'schemaVersion',
          'name',
          'gender',
          'savedAt',
          'torsoIndex',
          'pantsIndex',
          'torso',
          'pants',
          'archived',
          'createdAt',
          'updatedAt'
        ])
        && outfit.keys().hasOnly([
          'schemaVersion',
          'name',
          'gender',
          'savedAt',
          'torsoIndex',
          'pantsIndex',
          'vestIndex',
          'shoesIndex',
          'tshirtIndex',
          'torso',
          'vest',
          'pants',
          'shoes',
          'tshirt',
          'archived',
          'createdAt',
          'updatedAt'
        ])
        && validOutfitFields(outfit)
        && outfit.createdAt is timestamp
        && outfit.updatedAt is timestamp;
    }

    match /allowedUsers/{uid} {    match /allowedUsers/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || approved());
      allow list: if approved();
      allow write: if false;
    }

    match /users/{uid}/outfits/{outfitId} {
      allow read: if approved()
        && approvedUid(uid)
        && (request.auth.uid == uid || resource.data.archived == false);
      allow create: if approved()
        && request.auth.uid == uid
        && validStoredOutfit(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if approved()
        && request.auth.uid == uid
        && validStoredOutfit(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if approved() && request.auth.uid == uid;
    }

    match /suggestions/{suggestionId} {
      allow create: if approved()
        && request.resource.data.keys().hasAll(['fromUid','toUid','message','status','createdAt','outfit'])
        && request.resource.data.keys().hasOnly(['fromUid','toUid','message','status','createdAt','outfit'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && approvedUid(request.resource.data.toUid)
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && validOutfit(request.resource.data.outfit);

      allow read: if approved()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);

      allow update: if approved() && (
        (
          resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted','declined']
        )
        ||
        (
          resource.data.fromUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'withdrawn'
        )
      );

      allow delete: if false;
    }

    match /catalog/{document=**} {
      allow read: if approved();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
